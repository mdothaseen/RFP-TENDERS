# Copy to .env. Do not commit .env or paste its values into logs.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
EMAIL_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WINDOWS_TOAST=false

# Required for --serve. Use a unique password of at least 12 characters.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Optional external dead-man monitor. It must alert if light checks stop calling this URL.
HEARTBEAT_URL=

