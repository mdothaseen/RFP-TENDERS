# Copy to .env. Do not commit .env or paste its values into logs.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
EMAIL_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WINDOWS_TOAST=false

# Required for --serve. Use a unique password of at least 12 characters.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Optional external dead-man monitor. It must alert if light checks stop calling this URL.
HEARTBEAT_URL=


# --- Only on the 24x7 server without Claude Code (leave empty on the laptop) ---
# AI_READER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=            (comma list, tried in order: free first, then cheap paid)
# OPENROUTER_DOCS_PER_RUN=15        (3 scans a day x 15 = 45, inside the ~50/day free limit)
# EMAIL_ONLY_WHEN_NEW=1        (no email when a scan found nothing new)

# --- On a desktop that runs Ollama (free local AI, e.g. Google Gemma; no login, no API bill) ---
# AI_READER=ollama
# OLLAMA_MODEL=gemma3:4b       (any model from `ollama list`; bigger = better but slower)
# OLLAMA_HOST=http://localhost:11434   (optional; default local)
# OLLAMA_DOCS_PER_RUN=40         (AI reads per round; a local model has no daily limit, only CPU time)
# OLLAMA_MAX_CHARS=60000       (optional; document text sent per request)
