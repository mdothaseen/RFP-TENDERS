[Unit]
Description=SSC Watch daily discovery (deeper on Sunday)
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=tendertracker
WorkingDirectory=/opt/tender-tracker
Environment=TZ=Asia/Kolkata
Environment=WINDOWS_TOAST=false
EnvironmentFile=-/etc/tender-tracker.env
ExecStart=/opt/tender-tracker/.venv/bin/python -m tender_tracker --force --defer-enrichment --workers 2
SuccessExitStatus=2 3
TimeoutStartSec=3h
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/tender-tracker
MemoryMax=1G
